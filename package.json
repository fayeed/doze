{
  "name": "doze",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:desktop": "pnpm --filter @doze/desktop dev",
    "dev:web": "pnpm --filter @doze/web dev",
    "build": "turbo run build",
    "build:desktop": "pnpm --filter @doze/desktop build",
    "build:web": "pnpm --filter @doze/web build",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@doze/config": "workspace:*",
    "eslint": "^10.0.0",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
