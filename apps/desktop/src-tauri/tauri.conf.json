{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Doze",
  "version": "0.2.0",
  "identifier": "app.getdoze.desktop",
  "build": {
    "beforeDevCommand": "node scripts/build-native.mjs",
    "beforeBuildCommand": "node scripts/build-native.mjs",
    "frontendDist": "../resources"
  },
  "app": {
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
