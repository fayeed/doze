<Window
    x:Class="Doze.SettingsUi.CountdownWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" KeyDown="KeyPressed">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Margin="20,0,100,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE708;" FontSize="18" />
                <TextBlock Text="Doze · Countdown" FontSize="12" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Margin="16,0,16,16" Style="{StaticResource SettingsCardStyle}"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid RowSpacing="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="ActionText" Text="Sleep in" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="TimeText" Text="01:00" FontSize="72" FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Display" Typography.NumeralAlignment="Tabular"
                               HorizontalAlignment="Center" AutomationProperties.Name="Time remaining" />
                    <TextBlock x:Name="Description" Text="Cancel the action or snooze for 15 minutes."
                               FontSize="14" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock x:Name="PreviewHint" Text="Preview only · No power action is scheduled."
                               FontSize="12" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SnoozeButton" Content="Snooze 15 minutes" Click="Snooze"
                            MinHeight="40" HorizontalAlignment="Stretch" />
                    <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel action" Click="Cancel"
                            MinHeight="40" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" />
                </Grid>
                <InfoBar x:Name="Notice" Grid.Row="2" IsOpen="False" IsClosable="True" />
            </Grid>
        </Border>
    </Grid>
</Window>
