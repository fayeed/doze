<Window
    x:Class="Doze.SettingsUi.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Margin="20,0,140,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE708;" FontSize="18" />
                <TextBlock Text="Doze Settings" FontSize="12" />
            </StackPanel>
        </Grid>
        <NavigationView x:Name="Navigation" Grid.Row="1"
                        PaneDisplayMode="Left" OpenPaneLength="240"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        AlwaysShowHeader="False" SelectionChanged="Navigate">
            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Name="Search" PlaceholderText="Find a setting"
                                TextChanged="SearchChanged" SuggestionChosen="SearchChosen"
                                QuerySubmitted="SearchSubmitted" />
            </NavigationView.AutoSuggestBox>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Overview" Tag="Overview"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="General" Tag="General"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Session defaults" Tag="Session defaults"><NavigationViewItem.Icon><FontIcon Glyph="&#xE708;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="After playback" Tag="After playback"><NavigationViewItem.Icon><FontIcon Glyph="&#xE995;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Notifications" Tag="Notifications"><NavigationViewItem.Icon><FontIcon Glyph="&#xEA8F;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Advanced" Tag="Advanced"><NavigationViewItem.Icon><FontIcon Glyph="&#xE115;" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="About Doze" Tag="About Doze"><NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Grid Margin="32,20,32,24" MaxWidth="920" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,24" Spacing="6">
                    <TextBlock x:Name="PageTitle" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock x:Name="PageDescription" TextWrapping="Wrap" Opacity="0.7" />
                </StackPanel>
                <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="Cards" Spacing="8" Padding="0,0,12,12" />
                </ScrollViewer>
                <StackPanel x:Name="Footer" Grid.Row="2" Spacing="12" Margin="0,16,0,0">
                    <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="SaveHint" Text="Changes apply when you save." VerticalAlignment="Center" Opacity="0.65" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ResetButton" Content="Reset defaults" Click="Reset" />
                            <Button x:Name="DiscardButton" Content="Discard" Click="Discard" />
                            <Button x:Name="SaveButton" Content="Save changes" Style="{StaticResource AccentButtonStyle}" Click="Save" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
